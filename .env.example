# Copy this file to ".env" (same folder) and change what you need.
# The .env file is private - it is NOT uploaded to Git.

# Port the server listens on
PORT=3000

# 1 = real SMS is connected (OTP is no longer shown inside the app). Leave empty for demo mode.
STAR_TV_SMS=

# Password used only when a brand-new data file is created (change it in the dashboard afterwards)
ADMIN_INITIAL_PASSWORD=star123

# How many days of daily backups to keep
BACKUP_KEEP_DAYS=30

# Optional: store data somewhere else (for example a hosting disk)
# DATA_DIR=D:\StarTVData
